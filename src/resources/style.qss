/*
 * NekoMusic — 全局 QSS（暗色 · 现代 ACG）
 * 玫红主色 / 樱花描边 / 深夜蓝底；与 Android 端视觉对齐，不用 emoji。
 */

/* ─── 全局 ──────────────────────────────────────────────── */
QWidget {
    font-family: "Segoe UI Variable", "Segoe UI", "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    color: #EAF0FA;
    font-size: 14px;
}

QMainWindow {
    background: transparent;
}

QToolTip {
    background: rgba(18, 20, 26, 245);
    color: #EAF0FA;
    border: 1px solid rgba(64, 197, 241, 45);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

QMenu {
    background: rgba(18, 20, 26, 252);
    border: 1px solid rgba(64, 197, 241, 38);
    border-radius: 10px;
    padding: 6px 4px;
}

QMenu::item {
    padding: 8px 28px 8px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: rgba(64, 197, 241, 38);
}

QMenu::separator {
    height: 1px;
    margin: 4px 10px;
    background: rgba(64, 197, 241, 28);
}

/* ─── 主窗口骨架 / 滚动区（Fusion 默认灰底会盖住主背景渐变）──────── */
#centralWidget {
    background: transparent;
}

#midWidget {
    background: transparent;
}

#contentColumn {
    background: transparent;
}

QStackedWidget#pageStack {
    background: transparent;
}

QStackedWidget#pageStack > QWidget {
    background: transparent;
}

/* 具名滚动区（视口在 Windows Fusion 下由 nekoPolishScrollAreaViewport 去不透明底） */
QScrollArea#sbScroll,
QScrollArea#hpScroll,
QScrollArea#recentScroll,
QScrollArea#favoritesScroll,
QScrollArea#playlistScroll,
QScrollArea#ppScroll,
QScrollArea#lyricsScroll,
QScrollArea#settingsScroll,
QScrollArea#searchScroll,
QScrollArea#vipScroll {
    background: transparent;
    border: none;
}

QScrollArea#sbScroll > QWidget > QWidget,
QScrollArea#hpScroll > QWidget > QWidget,
QScrollArea#recentScroll > QWidget > QWidget,
QScrollArea#favoritesScroll > QWidget > QWidget,
QScrollArea#playlistScroll > QWidget > QWidget,
QScrollArea#ppScroll > QWidget > QWidget,
QScrollArea#lyricsScroll > QWidget > QWidget,
QScrollArea#settingsScroll > QWidget > QWidget,
QScrollArea#searchScroll > QWidget > QWidget,
QScrollArea#vipScroll > QWidget > QWidget {
    background: transparent;
}

QWidget#vipContainer {
    background: transparent;
}

/* 会员中心「刷新状态」：圆角不得超过高度一半，否则 Fusion 会画成方角 */
#vipRefreshBtn {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    border: none;
    border-radius: 17px;
    color: #0B1020;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

#vipRefreshBtn:hover {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #C9F0FA, stop:1 #40C5F1);
}

#vipRefreshBtn:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #40C5F1, stop:1 #1677B8);
}

/* 未命名行编辑（#dialogEdit、#settingsInput、#tbSearchInner 等用更高优先级覆盖） */
QLineEdit {
    background: rgba(238, 241, 246, 14);
    border: 1px solid rgba(64, 197, 241, 32);
    border-radius: 8px;
    padding: 7px 11px;
    color: #EAF0FA;
    min-height: 20px;
    selection-background-color: #40C5F1;
    selection-color: #0B1020;
}

QLineEdit:focus {
    border-color: rgba(64, 197, 241, 100);
    background: rgba(238, 241, 246, 22);
}

QLineEdit:disabled {
    color: rgba(238, 241, 246, 90);
    background: rgba(238, 241, 246, 8);
}

QTextEdit {
    background: rgba(238, 241, 246, 12);
    border: 1px solid rgba(64, 197, 241, 30);
    border-radius: 10px;
    padding: 8px;
    color: #EAF0FA;
    selection-background-color: #40C5F1;
    selection-color: #0B1020;
}

QTextEdit:focus {
    border-color: rgba(64, 197, 241, 100);
    background: rgba(238, 241, 246, 18);
}

/* 上传页等：行内输入此前无 QSS，Windows 上为系统灰框 */
#settingsInput {
    background: rgba(238, 241, 246, 16);
    border: 1px solid rgba(64, 197, 241, 35);
    border-radius: 10px;
    padding: 8px 12px;
    color: #EAF0FA;
    font-size: 13px;
    selection-background-color: #40C5F1;
    selection-color: #0B1020;
}

#settingsInput:focus {
    background: rgba(238, 241, 246, 24);
    border-color: rgba(64, 197, 241, 120);
}

#lyricsPreview, #coverPreview {
    background: rgba(238, 241, 246, 12);
    border: 1px solid rgba(64, 197, 241, 32);
    border-radius: 10px;
    color: #EAF0FA;
    padding: 8px;
    selection-background-color: #40C5F1;
    selection-color: #0B1020;
}

#smallBtn {
    background: rgba(238, 241, 246, 12);
    border: 1px solid rgba(64, 197, 241, 30);
    border-radius: 10px;
    color: #EAF0FA;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
}

#smallBtn:hover {
    background: rgba(64, 197, 241, 26);
}

#smallBtn:pressed {
    background: rgba(64, 197, 241, 14);
}

#primaryBtn {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    border: none;
    border-radius: 10px;
    color: #0B1020;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 22px;
}

#primaryBtn:hover {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #C9F0FA, stop:1 #40C5F1);
}

#primaryBtn:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #40C5F1, stop:1 #1677B8);
}

#backBtn {
    background: rgba(238, 241, 246, 8);
    border: none;
    border-radius: 10px;
}

#backBtn:hover {
    background: rgba(64, 197, 241, 28);
}

#backBtn:pressed {
    background: rgba(64, 197, 241, 14);
}

#pageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.2px;
}

#pageDesc {
    font-size: 13px;
    color: rgba(238, 241, 246, 150);
}

/* ─── 内容顶栏（SPlayer Nav）────────────────────────────── */
#titleBar {
    background: transparent;
    border: none;
}

#tbSearchWrap {
    background: rgba(255, 255, 255, 8);
    border: 1px solid rgba(255, 255, 255, 12);
    border-radius: 18px;
    min-height: 36px;
}

#tbSearchWrap:hover {
    background: rgba(255, 255, 255, 12);
    border-color: rgba(255, 255, 255, 20);
}

#tbSearchWrap[searchFocus="true"] {
    background: rgba(64, 197, 241, 18);
    border-color: rgba(64, 197, 241, 55);
}

#tbSearchGlyph {
    background: transparent;
}

#tbSearchInner {
    border: none;
    background: transparent;
    color: #EAF0FA;
    font-size: 13px;
    padding: 0;
    min-height: 22px;
    selection-background-color: #40C5F1;
    selection-color: #0B1020;
}

#tbSearchInner::placeholder {
    color: rgba(238, 241, 246, 140);
}

#tbAvatarWidget {
    background: rgba(238, 241, 246, 10);
    border: 1px solid rgba(64, 197, 241, 38);
    border-radius: 20px;
    min-height: 38px;
}

#tbAvatarWidget:hover {
    background: rgba(64, 197, 241, 20);
    border-color: rgba(64, 197, 241, 65);
}

#tbAvatarWidget:pressed {
    background: rgba(64, 197, 241, 14);
}

#tbNickname {
    font-size: 13px;
    color: #EAF0FA;
    font-weight: 500;
    letter-spacing: 0.2px;
    padding: 0 2px 0 0;
    background: transparent;
}

#tbAccountChevron {
    background: transparent;
}

#tbIconBtn {
    background: rgba(255, 255, 255, 8);
    border: none;
    border-radius: 16px;
    color: rgba(238, 241, 246, 180);
    font-size: 14px;
}

#tbIconBtn:hover {
    background: rgba(255, 255, 255, 14);
    color: #EAF0FA;
}

#tbIconBtn:pressed {
    background: rgba(255, 255, 255, 6);
}

/* ─── 窗口控制按钮（低调，hover 时显色）────────────── */
#tbMinBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: rgba(238, 241, 246, 160);
}

#tbMinBtn:hover {
    background: rgba(64, 197, 241, 55);
    color: #EAF0FA;
}

#tbMinBtn:pressed {
    background: rgba(64, 197, 241, 35);
}

#tbMaxBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: rgba(238, 241, 246, 160);
}

#tbMaxBtn:hover {
    background: rgba(64, 197, 241, 50);
    color: #E2F7F7;
}

#tbMaxBtn:pressed {
    background: rgba(64, 197, 241, 32);
}

#tbCloseBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: rgba(238, 241, 246, 160);
}

#tbCloseBtn:hover {
    background: rgba(64, 197, 241, 72);
    color: #FFFFFF;
}

#tbCloseBtn:pressed {
    background: rgba(64, 197, 241, 48);
}

/* ─── 侧边栏（WinUI 3 NavigationView）──────────────────── */
#sbScroll, #sbContainer { background: transparent; }

#sbLogoRow {
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 8);
}

#sbLogoText {
    font-size: 18px;
    font-weight: 600;
    color: rgba(238, 241, 246, 232);
    letter-spacing: -0.2px;
}

#sbNavItem {
    background: transparent;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    border-radius: 8px;
    color: rgba(238, 241, 246, 190);
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    padding: 8px 14px 8px 11px;
}

#sbNavItem:hover {
    background: rgba(255, 255, 255, 10);
    border-color: rgba(255, 255, 255, 12);
    border-left-color: transparent;
    color: #FFFFFF;
}

#sbNavItem:pressed {
    background: rgba(255, 255, 255, 6);
    color: rgba(238, 241, 246, 215);
}

#sbNavItem[active="true"] {
    background: rgba(255, 255, 255, 13);
    border-color: rgba(255, 255, 255, 16);
    border-left-color: #8ADFF5;
    color: #FFFFFF;
    font-weight: 600;
}

#sbNavItem:disabled {
    color: rgba(238, 241, 246, 55);
}

#sbDivider {
    background: rgba(255, 255, 255, 10);
    margin: 6px 8px;
}

#sbPlaylistTitle {
    font-size: 12px;
    color: rgba(238, 241, 246, 118);
    padding: 12px 12px 4px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

#sbCreatePlaylist {
    background: rgba(255, 255, 255, 7);
    border: 1px solid rgba(255, 255, 255, 12);
    border-radius: 8px;
    color: rgba(238, 241, 246, 205);
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    padding: 0 12px;
}

#sbCreatePlaylist:hover {
    background: rgba(255, 255, 255, 12);
    border-color: rgba(255, 255, 255, 20);
    color: #FFFFFF;
}

#sbCreatePlaylist:pressed {
    background: rgba(255, 255, 255, 7);
}

#sbEmpty, #sbEmptyPlaylist {
    font-size: 12px;
    color: rgba(238, 241, 246, 82);
    padding: 14px;
}

#playlistListItemName {
    font-size: 13px;
    color: rgba(238, 241, 246, 190);
}

/* ─── 轮播 ──────────────────────────────────────────────── */
#carouselBg { background: transparent; border-radius: 0; }

#carouselOverlay {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 transparent, stop:0.45 rgba(24, 24, 24, 80), stop:1 rgba(24, 24, 24, 210));
}

#carouselTitle {
    font-size: 26px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.3px;
}

#carouselDesc {
    font-size: 13px;
    color: rgba(238, 241, 246, 168);
    line-height: 1.45;
}

#carouselPlayBtn {
    background: qlineargradient(x1:0,y1:0,x2:0.35,y2:1,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    border: none;
    border-radius: 22px;
    color: #0B1020;
    font-weight: 700;
    font-size: 13px;
    padding: 2px 4px;
}

#carouselPlayBtn:hover {
    background: qlineargradient(x1:0,y1:0,x2:0.35,y2:1,
        stop:0 #C9F0FA, stop:1 #40C5F1);
}

#carouselPlayBtn:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0.35,y2:1,
        stop:0 #40C5F1, stop:1 #1677B8);
}

#carouselPrev, #carouselNext {
    background: rgba(238, 241, 246, 18);
    border: 1px solid rgba(64, 197, 241, 22);
    border-radius: 14px;
    color: rgba(238, 241, 246, 190);
    font-size: 16px;
}

#carouselPrev:hover, #carouselNext:hover {
    background: rgba(64, 197, 241, 42);
    color: #FFFFFF;
}

#carouselPrev:pressed, #carouselNext:pressed {
    background: rgba(64, 197, 241, 26);
}

#carouselDot {
    color: rgba(238, 241, 246, 60);
    font-size: 10px;
}

#carouselDot[active="true"] {
    color: #8ADFF5;
}

/* ─── 首页 ──────────────────────────────────────────────── */
#hpScroll, #hpContainer { background: transparent; }

#hpSectionTitle {
    font-size: 22px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.3px;
}

#hpLoading {
    color: rgba(238, 241, 246, 120);
    font-size: 14px;
    padding: 40px;
}

#hpHotTitle {
    font-size: 14px;
    font-weight: 600;
    color: rgba(238, 241, 246, 200);
}

#hpHotCount {
    font-size: 12px;
    color: rgba(238, 241, 246, 120);
}

#hpLatestTitle {
    font-size: 14px;
    font-weight: 600;
    color: rgba(238, 241, 246, 200);
}

#hpLatestCount {
    font-size: 12px;
    color: rgba(238, 241, 246, 120);
}

/* ─── 设置页 ──────────────────────────────────────────────── */
#settingsTitle {
    font-size: 25px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0;
}

#settingsTabBar {
    background: transparent;
}

#settingsTabScroller {
    background: transparent;
    border: none;
}

#settingsTabScroller > QWidget > QWidget {
    background: transparent;
}

#settingsStack {
    background: transparent;
    border: none;
}

#settingsTabBtn {
    background: rgba(238, 241, 246, 12);
    border: 1px solid rgba(238, 241, 246, 18);
    border-radius: 8px;
    color: rgba(238, 241, 246, 175);
    font-size: 13px;
    font-weight: 600;
    padding: 8px 14px;
}

#settingsTabBtn:hover {
    background: rgba(64, 197, 241, 24);
    border-color: rgba(64, 197, 241, 55);
    color: #FFFFFF;
}

#settingsTabBtn:checked {
    background: rgba(64, 197, 241, 42);
    border-color: rgba(64, 197, 241, 120);
    color: #FFFFFF;
}

#settingsLabel {
    font-size: 14px;
    font-weight: 600;
    color: rgba(238, 241, 246, 180);
}

#settingsInfo {
    font-size: 14px;
    color: rgba(238, 241, 246, 160);
}

#settingsLinkBtn {
    background: transparent;
    border: none;
    color: #D98E9F;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    padding: 4px 0;
    text-decoration: underline;
}

#settingsLinkBtn:hover {
    color: #FF97A8;
}

#settingsInput {
    background: rgba(238, 241, 246, 16);
    border: 1px solid rgba(64, 197, 241, 35);
    border-radius: 10px;
    padding: 0 12px;
    color: #EAF0FA;
    font-size: 13px;
}

#settingsInput:focus {
    border: 1px solid rgba(64, 197, 241, 120);
}

#settingsPrimaryBtn {
    background: #36A9D2;
    border: none;
    border-radius: 10px;
    padding: 7px 18px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
}

#settingsPrimaryBtn:hover {
    background: #FF5070;
}

#settingsPrimaryBtn:disabled {
    background: rgba(216, 75, 99, 0.35);
    color: rgba(255, 255, 255, 0.6);
}

#settingsDivider {
    background: rgba(64, 197, 241, 30);
    max-height: 1px;
}

#settingsCombo {
    background: rgba(238, 241, 246, 16);
    border: 1px solid rgba(64, 197, 241, 35);
    border-radius: 10px;
    padding: 7px 14px;
    color: #EAF0FA;
    font-size: 13px;
    min-width: 140px;
}

#settingsCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 28px;
}

#settingsCombo QAbstractItemView {
    background: #151923;
    color: #EAF0FA;
    selection-background-color: rgba(64, 197, 241, 50);
    selection-color: #FFFFFF;
    border: 1px solid rgba(64, 197, 241, 40);
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

#settingsCombo QAbstractItemView::item {
    min-height: 26px;
    padding: 6px 10px;
    border-radius: 6px;
}

#settingsCombo QAbstractItemView::item:hover {
    background: rgba(64, 197, 241, 22);
}

#settingsCombo QAbstractItemView::item:selected {
    background: rgba(64, 197, 241, 48);
    color: #FFFFFF;
}

#shortcutCaptureBtn {
    background: rgba(238, 241, 246, 16);
    border: 1px solid rgba(64, 197, 241, 35);
    border-radius: 8px;
    color: rgba(238, 241, 246, 205);
    font-size: 13px;
    font-weight: 600;
    padding: 4px 12px;
}

#shortcutCaptureBtn:hover {
    background: rgba(64, 197, 241, 20);
    border-color: rgba(64, 197, 241, 80);
    color: #FFFFFF;
}

#shortcutCaptureBtn[capturing="true"] {
    background: rgba(64, 197, 241, 42);
    border-color: rgba(64, 197, 241, 140);
    color: #FFFFFF;
}

#shortcutCaptureBtn:pressed {
    background: rgba(64, 197, 241, 58);
}

#checkUpdateBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
}

#checkUpdateBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #C9F0FA, stop:1 #FF8CA0);
}

#checkUpdateBtn:pressed {
    background: #1677B8;
}

#checkUpdateBtn:disabled {
    background: rgba(238, 241, 246, 28);
    color: rgba(238, 241, 246, 95);
}

/* ─── 歌单卡片 ──────────────────────────────────────────── */
#plCover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    border-radius: 14px;
}

#plName {
    font-size: 13px;
    font-weight: 600;
    color: rgba(238, 241, 246, 210);
}

/* ─── 播放栏（SPlayer MainPlayer 布局）──────────────────── */
#pbMainRow {
    background: transparent;
}

#pbLeft, #pbCenter, #pbRight {
    background: transparent;
}

/* 轨道/圆点由 PlayerProgressSlider 自绘；隐藏 Fusion 默认滑块外观 */
#pbProgress::groove:horizontal,
#pbProgress::handle:horizontal,
#pbProgress::sub-page:horizontal,
#pbProgress::add-page:horizontal {
    height: 0;
    width: 0;
    margin: 0;
    border: none;
    background: transparent;
}

#pbTimeBlock {
    background: transparent;
}

#pbTimeSep {
    font-size: 12px;
    color: rgba(64, 197, 241, 200);
    background: transparent;
    padding: 0 2px;
}

#pbCover { border-radius: 8px; }

#pbSong {
    font-size: 16px;
    font-weight: 700;
    color: #EAF0FA;
}

#pbArtist, #pbLyric {
    font-size: 12px;
    font-weight: 400;
    color: rgba(238, 241, 246, 140);
    background: transparent;
}

#pbLyricSlot {
    background: transparent;
}

/* 勿对带 QIcon 的按钮设 color，否则 Fusion 等样式会把图标整颗染成单色（常见为纯黑） */
/* 播放键 48×48：圆角不得超过半边长，否则 CE_PushButton 易画成方角 */
#pbPlayBtn {
    background: qlineargradient(x1:0,y1:0,x2:0.38,y2:1,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    border: none;
    border-radius: 22px;
}

#pbPlayBtn:hover {
    background: qlineargradient(x1:0,y1:0,x2:0.38,y2:1,
        stop:0 #C9F0FA, stop:1 #40C5F1);
}

#pbPlayBtn:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0.38,y2:1,
        stop:0 #40C5F1, stop:1 #1677B8);
}

#pbCtrlBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
}

#pbCtrlBtn:hover {
    background: rgba(255, 255, 255, 26);
}

#pbCtrlBtn:pressed {
    background: rgba(255, 255, 255, 14);
}

#pbPlayModeBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
}

#pbPlayModeBtn:hover {
    background: rgba(255, 255, 255, 26);
}

#pbPlayModeBtn:pressed {
    background: rgba(255, 255, 255, 14);
}

#pbHeartBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
}

#pbHeartBtn:hover {
    background: rgba(64, 197, 241, 20);
}

#pbHeartBtn:pressed {
    background: rgba(64, 197, 241, 12);
}

#pbPlaylistBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
}

#pbPlaylistBtn:hover {
    background: rgba(255, 255, 255, 26);
}

#pbPlaylistBtn:pressed {
    background: rgba(255, 255, 255, 14);
}

#pbVolumeBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
}

#pbVolumeBtn:hover {
    background: rgba(255, 255, 255, 26);
}

#pbVolumeBtn:pressed {
    background: rgba(255, 255, 255, 14);
}

#pbShareBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
}

#pbShareBtn:hover {
    background: rgba(255, 255, 255, 26);
}

#pbShareBtn:pressed {
    background: rgba(255, 255, 255, 14);
}

#pbDesktopLrcBtn {
    background: transparent;
    border: none;
    border-radius: 12px;
    color: rgba(255, 255, 255, 215);
    padding: 0;
}

#pbDesktopLrcBtn:hover {
    background: rgba(255, 255, 255, 26);
    color: #FFFFFF;
}

#pbDesktopLrcBtn:pressed {
    background: rgba(255, 255, 255, 14);
}

#pbDesktopLrcBtn:checked {
    background: rgba(64, 197, 241, 48);
    color: #FFF5F7;
}

#pbTime {
    font-size: 11px;
    color: rgba(238, 241, 246, 100);
}

/* ─── 滑块 ──────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: rgba(238, 241, 246, 22);
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #8ADFF5;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
    border: 1px solid rgba(64, 197, 241, 55);
}

QSlider::handle:horizontal:hover { background: #FFFFFF; }

QSlider::handle:horizontal:pressed {
    background: #8ADFF5;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    border-radius: 2px;
}

/* ─── 垂直滑块 ──────────────────────────────────────────── */
QSlider::groove:vertical {
    background: rgba(238, 241, 246, 22);
    width: 4px;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background: #8ADFF5;
    height: 12px;
    width: 12px;
    margin: 0 -4px;
    border-radius: 6px;
    border: 1px solid rgba(64, 197, 241, 55);
}

QSlider::handle:vertical:hover { background: #FFFFFF; }

QSlider::handle:vertical:pressed { background: #8ADFF5; }

QSlider::add-page:vertical {
    background: qlineargradient(x1:0,y1:1,x2:0,y2:0,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    border-radius: 2px;
}

#pbVolumeSlider::groove:vertical { width: 4px; }
#pbVolumeSlider::handle:vertical { width: 12px; height: 12px; margin: 0 -4px; border-radius: 6px; }

#pbVolumePanel {
    background: rgba(18, 20, 26, 248);
    border: 1px solid rgba(64, 197, 241, 42);
    border-radius: 12px;
}

#pbVolumeLabel {
    font-size: 10px;
    color: rgba(238, 241, 246, 180);
    font-weight: 600;
}

/* ─── 滚动条 ────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px 0;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: rgba(22, 119, 184, 70);
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover { background: rgba(22, 119, 184, 108); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0 2px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: rgba(22, 119, 184, 70);
    border-radius: 3px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover { background: rgba(22, 119, 184, 108); }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ─── 登录对话框 ────────────────────────────────────────── */
#dialogEdit {
    background: rgba(238, 241, 246, 16);
    border: 1px solid rgba(64, 197, 241, 35);
    border-radius: 10px;
    padding: 9px 14px;
    color: #EAF0FA;
    font-size: 13px;
    selection-background-color: #40C5F1;
}

#dialogEdit::placeholder { color: rgba(238, 241, 246, 90); }

#dialogEdit:focus {
    background: rgba(238, 241, 246, 24);
    border-color: rgba(64, 197, 241, 120);
}

#dialogBtn {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #8ADFF5, stop:1 #36A9D2);
    border: none;
    border-radius: 10px;
    color: #0B1020;
    font-size: 14px;
    font-weight: 600;
}

#dialogBtn:hover {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #C9F0FA, stop:1 #40C5F1);
}

#dialogBtn:pressed {
    background: qlineargradient(x1:0,y1:0,x2:0.32,y2:1,
        stop:0 #40C5F1, stop:1 #1677B8);
}

#dialogBtn:disabled {
    background: rgba(64, 197, 241, 80);
    color: rgba(26, 22, 37, 100);
}

#dialogLinkBtn {
    background: transparent;
    border: none;
    color: #D98E9F;
    font-size: 13px;
    text-decoration: underline;
}

#dialogLinkBtn:hover { color: #FF97A8; }

#dialogCloseBtn {
    background: rgba(238, 241, 246, 12);
    border: none;
    border-radius: 12px;
    color: rgba(238, 241, 246, 150);
    font-size: 20px;
    font-weight: bold;
}

#dialogCloseBtn:hover {
    background: rgba(64, 197, 241, 70);
    color: #FFFFFF;
}

#dialogCloseBtn:pressed {
    background: rgba(64, 197, 241, 48);
}
