#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba16f) uniform writeonly image2D fieldImage;

layout(push_constant) uniform Shape {
    vec2 size;
    float radius;
    float pixelWidth;
} shape;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(fieldImage);
    if (any(greaterThanEqual(pixel, extent)))
        return;

    vec2 halfSize = shape.size * 0.5;
    vec2 point = (vec2(pixel) + 0.5) * shape.size / vec2(extent) - halfSize;
    float radius = clamp(shape.radius, 0.0, min(halfSize.x, halfSize.y));
    vec2 q = abs(point) - halfSize + radius;
    vec2 corner = max(q, 0.0);
    float distance = length(corner) + min(max(q.x, q.y), 0.0) - radius;
    vec2 gradient = max(q.x, q.y) > 0.0 ? normalize(corner)
        : q.x > q.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    gradient *= mix(vec2(-1.0), vec2(1.0), greaterThanEqual(point, vec2(0.0)));
    float coverage = clamp(0.5 - distance / shape.pixelWidth, 0.0, 1.0);
    imageStore(fieldImage, pixel, vec4(distance, gradient, coverage));
}
